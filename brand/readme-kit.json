    {"key": "features", "type": "cards", "title": "ARGUE, WITH RECEIPTS", "items": [
      {"title": "DEBATE",  "text": "Five roles on one Claude model. The moderator frames, proposer and critic argue, the judge rules. Max 3 rounds by default."},
      {"title": "RESEARCH", "text": "Proposer and critic search the live web with Tavily, up to 4 tool calls per turn. Sources appear as inline links."},
      {"title": "TRACE",   "text": "Every call goes to LangSmith and Langfuse at the same time. Same run, two UIs. Tool errors stay visible."}
    ]},
    {"key": "start", "type": "terminal", "title": "QUICK START", "lines": [
      "$ git clone https://github.com/VelimirMueller/lab-debater.git",
      "$ cd lab-debater && pip install -r requirements.txt",
      "$ cp .env.example .env   # add 5 API keys",
      "$ python main.py \"Should remote work be the default?\""
    ]},
    {"key": "flow", "type": "flow", "title": "ONE LOOP, UNTIL THE JUDGE STOPS IT", "nodes": [
      {"title": "MODERATOR", "sub": "frames the question"},
      {"title": "PROPOSER", "sub": "argues for + searches", "hot": true},
      {"title": "CRITIC", "sub": "argues against + searches"},
      {"title": "JUDGE", "sub": "continue or verdict"}
    ], "caption": "The judge loops the graph until a verdict. The max_rounds cap (3) is defence in depth."},
